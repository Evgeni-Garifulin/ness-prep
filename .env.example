# --- Postgres (Neon через Vercel Marketplace, custom prefix POSTGRES) ---
# Локально подтягиваются командой `vercel env pull .env.local`.
# POSTGRES_PRISMA_URL      — pooled (через PgBouncer), для рантайма приложения
# POSTGRES_URL_NON_POOLING — прямой коннект, нужен Prisma для миграций (db push, migrate)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Auth ---
# Random string, минимум 16 символов. Можно сгенерировать: `openssl rand -hex 32`
SESSION_SECRET=

# Два пользователя (можно завести до 5 — AUTH_USER_3, AUTH_USER_4 ...)
AUTH_USER_1=Evgenii
AUTH_PASS_1=121212

AUTH_USER_2=Vladick
AUTH_PASS_2=121212
