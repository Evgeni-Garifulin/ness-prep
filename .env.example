# --- Postgres (Vercel Postgres / Neon) ---
# Copy these from Vercel → Storage → Postgres → ".env.local" tab
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Auth ---
# Random string, минимум 16 символов. Можно сгенерировать: `openssl rand -hex 32`
SESSION_SECRET=

# Два пользователя (можно завести до 5 — AUTH_USER_3, AUTH_USER_4 ...)
AUTH_USER_1=evgenii
AUTH_PASS_1=change-me

AUTH_USER_2=friend
AUTH_PASS_2=change-me-too
